<!DOCTYPE html>
<html lang="ja">
  <head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# article: http://ogp.me/ns/article#">
    <meta charset="utf-8">
    <title>{{ title }} | {{ siteTitle }}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="{{ url }}">
    <meta name="theme-color" content="#fbf9f4" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1c1b19" media="(prefers-color-scheme: dark)">
    <link rel="shortcut icon" href="{{ topUrl }}logo/favicon.png">
    <meta property="og:title" content="{{ title }} | {{ siteTitle }}" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="{{ url }}" />
    <meta property="og:image" content="{{ topUrl }}logo/logo-large.png" />
    <meta property="og:site_name" content="{{ siteTitle }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta name="twitter:card" content="summary" />
    <link href="./css/main.css" rel="stylesheet" type="text/css">
    <script src="./js/theme.js"></script>
  </head>
  <body>
    <header>
      <div class="header">
        <a class="header-title" href="index.html">{{ siteTitle }}</a>
      </div>
    </header>

    <main class="main">
      <article>
        {{{ article }}}
      </article>

      <nav class="pager" aria-label="{{ loc.PAGER_LABEL }}">
      {{#if prev.title}}
        <a class="pager-prev" href="{{ prev.fileName }}" rel="prev">
          <span class="pager-label">{{ loc.PREV_MESSAGE }}</span>
          <span class="pager-title">{{ prev.title }}</span>
        </a>
      {{/if}}
      {{#if next.title}}
        <a class="pager-next" href="{{ next.fileName }}" rel="next">
          <span class="pager-label">{{ loc.NEXT_MESSAGE }}</span>
          <span class="pager-title">{{ next.title }}</span>
        </a>
      {{else}}
        <a class="pager-next" href="index.html">
          <span class="pager-label">{{ loc.TO_TOP_MESSAGE }}</span>
          <span class="pager-title">{{ siteTitle }}</span>
        </a>
      {{/if}}
      </nav>
    </main>

    <footer>
      <nav aria-label="{{ loc.SITE_NAV_LABEL }}">
        <ul>
          <li><a href="index.html">{{ loc.TOC }}</a></li>
          <li><a href="../">{{ loc.BOOK_LIST }}</a></li>
        </ul>
      </nav>
      <p class="copy-right"><a href="{{ loc.URL }}">{{ loc.COPY_RIGHT }}</a></p>
    </footer>
  </body>
</html>
