<!DOCTYPE html>
<html lang="ja">
  <head prefix="og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# article: http://ogp.me/ns/article#">
    <meta charset="utf-8">
    <title>{{ siteTitle }}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="{{ description }}">
    <link rel="canonical" href="{{ url }}">
    <meta name="theme-color" content="#fbf9f4" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1c1b19" media="(prefers-color-scheme: dark)">
    <link rel="shortcut icon" href="{{ topUrl }}logo/favicon.png">
    <meta property="og:title" content="{{ siteTitle }}" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="{{ url }}" />
    <meta property="og:image" content="{{ topUrl }}logo/logo-large.png" />
    <meta property="og:site_name" content="{{ siteTitle }}" />
    <meta property="og:description" content="{{ description }}" />
    <link href="./css/main.css" rel="stylesheet" type="text/css">
    <script src="./js/theme.js"></script>
  </head>
  <body>
    <header>
      <div class="header">
        <a class="header-title" href="../">{{ loc.SITE_NAME }}</a>
      </div>
    </header>

    <main class="main">
      <div class="toc">
        <h1>{{ siteTitle }}</h1>
        {{#if intro}}
        <div class="book-intro">
          {{{ intro }}}
        </div>
        {{/if}}
        <h2>{{ loc.TOC }}</h2>
        <ul>
          {{#each nav}}
          <li><a href="{{fileName}}">{{title}}</a></li>
          {{/each}}
        </ul>
        {{#if completed}}
          <h2>ダウンロード版</h2>
          <a href="{{pdfUrl}}" class="download" download title="PDF形式でダウンロード">PDF形式</a>
          <a href="{{epubUrl}}" class="download" download title="EPUB形式でダウンロード">EPUB形式</a>
        {{/if}}
      </div>
    </main>

    <footer>
      <nav aria-label="{{ loc.SITE_NAV_LABEL }}">
        <ul>
          <li><a href="https://github.com/christian-classics-jp/site/tree/master/books/{{ repos }}">この本について（GitHub）</a></li>
          <li><a href="../">{{ loc.BOOK_LIST }}</a></li>
        </ul>
      </nav>
      <p class="copy-right"><a href="{{ loc.URL }}">{{ loc.COPY_RIGHT }}</a></p>
    </footer>
  </body>
</html>
