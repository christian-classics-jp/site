<section class="title-page">
  <h1 class="book-title">{{ title }}</h1>
  <p class="book-author">{{ author }}</p>
  <p class="book-translator">{{ translator }}　{{ credit.role }}</p>
</section>
<section class="colophon">
  <div class="colophon-box">
    <p class="colophon-title">{{ title }}</p>
    <p>{{{ edition }}}</p>
    <p>著者　{{ author }}</p>
    <p>{{ credit.label }}　{{ translator }}</p>
    <p>発行　{{ publisher }}</p>
    <p class="url">公開　{{ siteUrl }}</p>
    <p class="url">原稿　{{ reposUrl }}</p>
    {{#if credit.aiTranslation}}
    <p>{{ credit.aiTranslation }}</p>
    {{/if}}
    <p>{{ license.text }}引用した聖書の本文は含みません。</p>
  </div>
</section>
