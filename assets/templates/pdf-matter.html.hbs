<section class="title-page">
  <h1 class="book-title">{{ title }}</h1>
  <p class="book-author">{{ author }}</p>
  <p class="book-translator">{{ translator }}　訳</p>
</section>
<section class="colophon">
  <div class="colophon-box">
    <p class="colophon-title">{{ title }}</p>
    <p>{{{ edition }}}</p>
    <p>著者　{{ author }}</p>
    <p>翻訳　{{ translator }}</p>
    <p>発行　{{ publisher }}</p>
    <p class="url">公開　{{ siteUrl }}</p>
    <p class="url">原稿　{{ reposUrl }}</p>
    <p>訳文は CC BY-SA 4.0 で公開しています。引用した聖書の本文は含みません。</p>
  </div>
</section>
