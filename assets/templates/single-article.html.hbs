<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <title>{{ siteTitle }}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#fbf9f4" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1c1b19" media="(prefers-color-scheme: dark)">
    <link href="./css/main.css" rel="stylesheet" type="text/css">
    <script src="./js/theme.js"></script>
  </head>
  <body>
    <header>
      <div class="header">
        <a class="header-title" href="../">{{ loc.SITE_NAME }}</a>
      </div>
    </header>

    <main class="main">
      <article>
        {{{ article }}}
      </article>
    </main>

    <footer>
      <nav aria-label="{{ loc.SITE_NAV_LABEL }}">
        <ul>
          <li><a href="https://github.com/christian-classics-jp/{{ repos }}">この本について（GitHub）</a></li>
          <li><a href="../">{{ loc.BOOK_LIST }}</a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
